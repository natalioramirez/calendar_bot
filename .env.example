# Telegram Bot Token from @BotFather (required)
BOT_TOKEN=

# Database connection URL (default: local SQLite file)
DATABASE_URL=sqlite+aiosqlite:///tg_calendar.db

# Reminder polling interval in seconds
REMINDER_CHECK_INTERVAL_SECONDS=30

# Run the initial Islamic calendar sync when the bot boots (true/false).
# Set to false to avoid hitting the AlAdhan API on every startup; the monthly
# scheduled sync and the web panel's manual sync button keep working either way.
CALLS_ON_BOOT=true

# Islamic calendar event keywords to sync into calendar 'P', comma-separated.
# Leave it commented out to use the built-in curated list.
# CAUTION: setting it empty (ISLAMIC_ALLOWED_EVENTS=) disables the filter and imports every holiday.
# ISLAMIC_ALLOWED_EVENTS=Ramadan,Qadr,Fitr,Adha,Ashura,Mawlid

# Web Admin Flask Panel settings (the only administration interface)
WEB_ADMIN_HOST=127.0.0.1
WEB_ADMIN_PORT=5314

# Google Calendar settings (optional)
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_CALENDAR_ID=
